{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@config/*": ["packages/config/*"],
      "@clients/*": ["packages/clients/*"],
      "@workflow/*": ["packages/workflow/*"]
    }
  },
  "include": ["apps", "packages", "workers", "jobs", "scripts"],
  "exclude": ["node_modules"]
}
