{
  "name": "web-shoe-generator",
  "private": true,
  "packageManager": "pnpm@9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "lint": "pnpm --filter web lint",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bullmq": "^5.71.1",
    "form-data": "^4.0.5",
    "ioredis": "^5.10.1",
    "luxon": "^3.7.2",
    "mock-aws-s3": "^4.0.2",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.5.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
